{
  "name": "swig-github-pages",
  "version": "0.22.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "npm run test:stream && npm run test:store && npm run test:germline && npm run test:alignment && npm run test:post && npm run test:wasm",
    "test:stream": "node --experimental-strip-types --test tests/sequence-stream.test.ts tests/project-directory.test.ts",
    "test:store": "node --experimental-strip-types --test tests/result-store.test.ts",
    "test:germline": "node --experimental-strip-types --test tests/germline-preprocess.test.ts",
    "test:alignment": "node --experimental-strip-types --test tests/alignment-model.test.ts tests/balanced-calling-profile.test.ts",
    "test:post": "node --experimental-strip-types --test tests/post-analysis-core.test.ts tests/study-design.test.ts tests/analysis-extensions.test.ts tests/alignment-provenance.test.ts tests/alivibe-roundtrip.test.ts tests/ui-regressions.test.ts tests/phylogeny.test.ts tests/lineage-phylogeny.test.ts tests/lineage-neighbours.test.ts tests/kabat-numbering.test.ts tests/chimera-view-model.test.ts",
    "test:wasm": "node --experimental-strip-types --test tests/swiftig-wasm.test.mjs",
    "benchmark:50k": "node tests/benchmark-wasm-pool.mjs",
    "benchmark:denoise-50k": "node --experimental-strip-types tests/benchmark-denoise-50k.mjs",
    "benchmark:indel-denoise-50k": "node --experimental-strip-types tests/benchmark-denoise-50k.mjs --indel",
    "benchmark:missing-v-50k": "node --expose-gc --experimental-strip-types tests/benchmark-missing-v-50k.ts",
    "build:wasm": "bash scripts/build-swiftig-wasm.sh",
    "build:references": "node scripts/build-imgt-reference-pack.mjs"
  },
  "dependencies": {
    "@biowasm/aioli": "^3.2.3",
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "immunum": "^1.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "binaryen": "131.0.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
